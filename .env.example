# Lumina — example environment
#
# Copy to .env (and/or backend/.env) for development. The desktop app does not
# need this file: it stores credentials in the OS keychain and injects them into
# the backend process at launch, so nothing is ever written here in the clear.

# ── Model providers (at least one required) ────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_NIMS_API_KEY=

# Optional OpenRouter attribution, shown on their rankings/usage pages.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Lumina

# ── Email MCP (optional) ───────────────────────────────────────────────────
# Without these, send_email refuses to run rather than silently doing nothing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Runtime ────────────────────────────────────────────────────────────────
PORT=3000
# debug | info | warn | error | silent
LOG_LEVEL=info
# Where the SQLite database and email drafts live. Electron overrides this.
# LUMINA_DATA_DIR=
# Opt in to the desktop-automation MCP server (drives the real cursor).
# LUMINA_ENABLE_AUTOGUI=0
